# Provider: gemini or openai. Keep secrets only in this server file.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8787

# Optional: set AI_PROVIDER=openai to use the original provider.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Image generation has its own model access/quota. Enable only when ready to use it.
IMAGE_GENERATION_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional separate key; otherwise the backend uses GEMINI_API_KEY.
# GEMINI_IMAGE_API_KEY=
# Generated images and job metadata stay on this machine (not in Git).
# ILLUSTRATION_CACHE_DIR=server/.cache/illustrations

# Podcast: Microsoft Edge TTS (default, free, no API key needed) or FPT.AI
PODCAST_PROVIDER=edge
# Optional voice: vi-VN-HoaiMyNeural (female, default) or vi-VN-NamMinhNeural (male)
# PODCAST_VOICE=vi-VN-HoaiMyNeural
# Optional FPT.AI key if setting PODCAST_PROVIDER=fpt:
# FPT_API_KEY=
# PODCAST_CACHE_DIR=backend/.cache/podcasts

# Optional cache for incremental course outlines and generated lessons.
# COURSE_CACHE_DIR=server/.cache/courses
